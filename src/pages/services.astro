---
import Layout from '../components/Layout.astro';
import { v2 as cloudinary } from 'cloudinary';

cloudinary.config({
  cloud_name: import.meta.env.CLOUDINARY_CLOUD_NAME,
  api_key: import.meta.env.CLOUDINARY_API_KEY,
  api_secret: import.meta.env.CLOUDINARY_API_SECRET,
});

async function getServiceImage(name: string) {
  try {
    const result = await cloudinary.search
      .expression(`folder:bruce-bybee AND display_name=${name}`)
      .max_results(1)
      .execute();
    const resource = result.resources?.[0];
    if (!resource) return null;
    return cloudinary.url(resource.public_id, {
      format: 'webp',
      quality: 88,
      width: 800,
      height: 800,
      crop: 'fill',
      gravity: 'auto',
    });
  } catch {
    return null;
  }
}

// Square images: upload to Cloudinary (bruce-bybee folder) with these display names
const [liveEventsImg, exhibitionsImg, portraitureImg, touringImg, translationImg] = await Promise.all([
  getServiceImage('service_live_events'),
  getServiceImage('service_exhibitions'),
  getServiceImage('service_portraiture'),
  getServiceImage('service_touring_artists'),
  getServiceImage('service_translation'),
]);

const services = [
  {
    title: 'Live Events & Performances',
    description: 'Coverage for concerts, theater productions, lectures, readings, and public programs. Includes key moments, audience engagement, and environmental atmosphere.',
    price: 'From $200 / hour',
    projectType: 'Live Events & Performances',
    img: liveEventsImg,
  },
  {
    title: 'Exhibitions & Installations',
    description: 'Gallery documentation, installation views, artwork detail photography, and architectural context for museums, curators, and exhibiting artists.',
    price: 'From $200 / hour',
    projectType: 'Exhibitions & Installations',
    img: exhibitionsImg,
  },
  {
    title: 'Portraiture',
    description: 'Artist portraits, editorial sessions, and professional headshots — on location or in studio.',
    price: 'From $150 / hour',
    projectType: 'Portraiture',
    img: portraitureImg,
  },
  {
    title: 'Touring Artists',
    description: 'Press photography, performance documentation, promotional imagery, and expedited delivery for artists performing in New York City.',
    price: 'Custom packages available',
    projectType: 'Touring Artist Coverage',
    img: touringImg,
  },
  {
    title: 'Translation & Interpretation',
    description: 'Czech–English translation for contemporary literature, cultural writing, exhibition texts, press materials, and public programs. Samples and references available upon request.',
    price: 'Rates upon request',
    projectType: 'Translation / Interpretation',
    img: translationImg,
  },
];

const details = [
  {
    title: 'Delivery & Booking',
    items: [
      { label: null, text: 'Approximately 15 edited images per hour of coverage.' },
      { label: null, text: 'Standard delivery within 3 days via private online gallery.' },
      { label: null, text: '50% deposit required to confirm booking.' },
    ],
  },
  {
    title: 'Additional Options',
    items: [
      { label: 'Expedited Delivery', text: 'Select images delivered within 12-24 hours for press and promotional use.' },
      { label: 'Institutional Partnerships', text: 'Ongoing event and exhibition coverage for organizations seeking consistent documentation throughout a season or program year.' },
      { label: 'Usage & Licensing', text: 'Standard coverage includes non-exclusive promotional and editorial use. Commercial campaigns, extended usage, or exclusive rights can be licensed separately. Photographer retains copyright unless otherwise agreed in writing.' },
      { label: 'Cancellation Policy', text: 'Cancellations within 48 hours of the scheduled booking may be subject to a fee.' },
    ],
  },
];
---

<Layout title="Services - Bruce Bybee Photography">
  <!-- Page loader overlay -->
  <div id="page-loader" class="fixed inset-0 bg-stone-50 z-[100]" style="transition: opacity 0.6s ease;"></div>

  <section class="page-section">
    <h1 class="page-title mb-4">Services</h1>
  </section>

  <!-- Service rows -->
  <section class="max-w-6xl mx-auto px-8 pb-8">
    {services.map((service, index) => (
      <div class="border-t border-gray-200 py-2 md:py-4 grid grid-cols-1 md:grid-cols-[3rem_280px_1fr] gap-6 md:gap-10 items-center">
        <!-- Number -->
        <span class="text-sm tracking-widest text-gray-400">{String(index + 1).padStart(2, '0')}</span>

        <!-- Square image -->
        <div class="aspect-square w-full max-w-[280px] overflow-hidden bg-gray-100">
          {service.img && (
            <img
              src={service.img}
              alt={service.title}
              class="svc-img w-full h-full object-cover"
              loading={index < 2 ? 'eager' : 'lazy'}
            />
          )}
        </div>

        <!-- Text + arrow -->
        <div class="md:pl-8">
          <h2 class="text-xl md:text-2xl font-serif uppercase tracking-wide text-gray-900 mb-3">
            {service.title}
          </h2>
          <p class="text-sm md:text-base text-gray-600 leading-relaxed mb-6 max-w-md">
            {service.description}
          </p>
          <a
            href="/contact"
            data-project-type={service.projectType}
            class="contact-modal-trigger group flex items-center justify-between max-w-md cursor-pointer"
            aria-label={`Inquire about ${service.title}`}
          >
            <span class="text-xs tracking-widest uppercase text-gray-900 group-hover:text-gray-500 transition-colors duration-300">{service.price}</span>
            <span class="text-2xl text-gray-900 group-hover:text-gray-500 transition-all duration-300">
              <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
            </span>
          </a>
        </div>
      </div>
    ))}
  </section>

  <!-- Delivery & Booking / Additional Options -->
  <section class="border-t border-gray-200 bg-gray-50">
    <div class="max-w-6xl mx-auto px-8 py-20 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
      {details.map((block) => (
        <div>
          <h2 class="text-lg font-serif uppercase tracking-wide text-gray-900 mb-6">{block.title}</h2>
          <ul class="space-y-4">
            {block.items.map((item) => (
              <li class="text-sm md:text-base text-gray-600 leading-relaxed">
                {item.label && <span class="font-semibold text-gray-900">{item.label}: </span>}
                {item.text}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Strip -->
  <div class="bg-gray-900 py-20 text-center border-t border-gray-800">
    <p class="body-text text-white/80 mb-8">Ready to work together? I'd love to hear about your project.</p>
    <a href="/contact" class="contact-modal-trigger inline-block px-10 py-4 text-sm tracking-widest uppercase border border-white text-white hover:bg-stone-50 hover:text-gray-900 transition-all duration-300">
      Get in Touch
    </a>
  </div>
</Layout>

<script>
  const loader = document.getElementById('page-loader') as HTMLElement;
  const imgs = Array.from(document.querySelectorAll('.svc-img')) as HTMLImageElement[];

  function revealPage() {
    if (!loader) return;
    loader.style.opacity = '0';
    setTimeout(() => loader.remove(), 600);
  }

  if (imgs.length === 0) {
    revealPage();
  } else {
    let loaded = 0;
    function onLoad() {
      loaded++;
      if (loaded >= imgs.length) revealPage();
    }
    imgs.forEach(img => {
      if (img.complete) {
        onLoad();
      } else {
        img.addEventListener('load', onLoad);
        img.addEventListener('error', onLoad);
      }
    });
    setTimeout(revealPage, 6000);
  }
</script>
