---
import Layout from '../components/Layout.astro';
import { v2 as cloudinary } from 'cloudinary';

// Configure Cloudinary
cloudinary.config({
  cloud_name: import.meta.env.CLOUDINARY_CLOUD_NAME,
  api_key: import.meta.env.CLOUDINARY_API_KEY,
  api_secret: import.meta.env.CLOUDINARY_API_SECRET,
});

async function getSlideshowImages() {
  try {
    const result = await cloudinary.search
      .expression('folder:bruce-bybee/featured_images/*')
      .sort_by('created_at', 'desc')
      .max_results(10)
      .execute();

    return result.resources.map(resource => ({
      src: cloudinary.url(resource.public_id, {
        format: 'webp',
        quality: 90,
        width: 1920,
        crop: 'limit',
      }),
      alt: resource.public_id.split('/').pop().replace(/[-_]/g, ' '),
    }));
  } catch {
    return [];
  }
}

const slideshowImages = await getSlideshowImages();
---

<Layout title="Bruce Bybee Photography">
  <!-- Page loader overlay -->
  <div id="page-loader" class="fixed inset-0 bg-white z-[100]" style="transition: opacity 0.6s ease;"></div>
  <!-- Hero Slideshow -->
  <section class="min-h-screen flex items-center justify-center relative overflow-hidden">
    <!-- Slideshow images -->
    {slideshowImages.map((image, index) => (
      <div
        class="slideshow-slide absolute inset-0 transition-opacity duration-1000 ease-in-out"
        style={`opacity: ${index === 0 ? '1' : '0'}`}
      >
        <img
          id={index === 0 ? 'first-slide-img' : undefined}
          src={image.src}
          alt={image.alt}
          class="w-full h-full object-cover"
          loading={index === 0 ? 'eager' : 'lazy'}
        />
      </div>
    ))}

    <!-- Overlay -->
    <div class="absolute inset-0 bg-black/30 z-10"></div>

    <!-- Content -->
    <div class="relative z-20 max-w-3xl mx-auto px-8 text-center">
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-serif leading-tight mb-6 text-white">
        Intentional Photography for New York's Cultural Landscape
      </h1>
      <p class="text-base md:text-lg tracking-wide text-white/85">
        Manhattan-based photographer specializing in performances, exhibitions, and portraiture.
      </p>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="max-w-3xl mx-auto px-8 py-24">
    <p class="text-lg leading-relaxed text-gray-700">
      Bruce Bybee is a Manhattan-based photographer working with artists, institutions, and cultural organizations. He creates atmospheric, precise imagery for live performances, exhibitions, public programs, and portrait sessions. With a background in film and over a decade of experience spanning analog and digital photography, he brings clarity, structure, and consistency to every assignment. Available for commissions in Manhattan, Brooklyn, and beyond.
    </p>
  </section>

  <!-- Services Preview Section -->
  <section class="max-w-3xl mx-auto px-8 py-24 border-t border-gray-100">
    <h2 class="text-2xl md:text-3xl font-serif mb-8 text-center">Services</h2>
    <ul class="space-y-6 text-lg leading-relaxed text-gray-700">
      <li><span class="font-semibold text-gray-900">Live Events & Performances:</span> Concerts, theater, readings and public programs</li>
      <li><span class="font-semibold text-gray-900">Exhibitions & Installations:</span> Documentation of gallery and museum environments</li>
      <li><span class="font-semibold text-gray-900">Portraiture:</span> Artist portraits and professional headshots</li>
      <li><span class="font-semibold text-gray-900">Touring Artists:</span> Press-ready photography and performance documentation for visiting productions</li>
      <li><span class="font-semibold text-gray-900">Translation:</span> Czech to English translation services for professional and personal use</li>
    </ul>
    <div class="text-center mt-12">
      <a href="/services" class="inline-block px-8 py-3 text-sm tracking-wide bg-gray-900 text-white hover:bg-gray-800 transition-colors">
        View Services
      </a>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="max-w-3xl mx-auto px-8 py-24 border-t border-gray-100">
    <h2 class="text-2xl md:text-3xl font-serif mb-4 text-center">Contact</h2>
    <p class="text-lg leading-relaxed text-gray-700 text-center">
      Tell me about your project, date, and location. I typically respond within 24 hours.
    </p>
    <div class="text-center mt-12">
      <a href="/contact" class="inline-block px-8 py-3 text-sm tracking-wide bg-gray-900 text-white hover:bg-gray-800 transition-colors">
        Book Now
      </a>
    </div>
  </section>

  <script>
    const loader = document.getElementById('page-loader') as HTMLElement;
    const firstImg = document.getElementById('first-slide-img') as HTMLImageElement;

    function revealPage() {
      if (!loader) return;
      loader.style.opacity = '0';
      setTimeout(() => loader.remove(), 600);
    }

    if (!firstImg) {
      revealPage();
    } else if (firstImg.complete) {
      revealPage();
    } else {
      firstImg.addEventListener('load', revealPage);
      firstImg.addEventListener('error', revealPage);
      // Safety fallback in case image never fires
      setTimeout(revealPage, 6000);
    }

    // Slideshow
    const slides = document.querySelectorAll('.slideshow-slide');
    if (slides.length > 1) {
      let current = 0;
      setInterval(() => {
        (slides[current] as HTMLElement).style.opacity = '0';
        current = (current + 1) % slides.length;
        (slides[current] as HTMLElement).style.opacity = '1';
      }, 5000);
    }
  </script>
</Layout>
