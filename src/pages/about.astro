---
import Layout from '../components/Layout.astro';
---
// Fetch hero image from Cloudinary (looks for any file named "profile" in bruce-bybee/)
async function getHeroImage() {
  try {
    const result = await cloudinary.search
      .expression('folder:bruce-bybee AND display_name=hero')
      .max_results(1)
      .execute();

    const resource = result.resources?.[0];
    if (!resource) return null;

    return cloudinary.url(resource.public_id, {
      format: 'webp',
      quality: 90,
      width: 1920,
      crop: 'limit',
    });
  } catch {
    return null;
  }
}
const heroImage = await getHeroImage();

<Layout title="About - Bruce Bybee Photography">
  <section class="max-w-3xl mx-auto px-8 py-24">
    <h1 class="text-3xl md:text-4xl font-serif mb-12 text-center">About</h1>
    <div class="space-y-6 text-lg leading-relaxed text-gray-700">
      <p>Bruce Bybee is a Manhattan-based photographer specializing in cultural events, performances, exhibitions, and portraiture.</p>
      <p>He began working with manual analog photography in 2014, developing a disciplined understanding of light, timing, and material process before expanding into digital formats and commissioned work in 2023.</p>
      <p>Bruce received a B.A. with honors in Modern Culture and Media from Brown University and completed a certificate in Film Production at FAMU in Prague. His training in visual theory and cinema continues to inform his photographic practice, particularly in his attention to structure, rhythm, and atmosphere.</p>
      <p>Originally from Prague, he is a native bilingual Czech–English speaker and has lived and worked between both languages his entire life.</p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-8 py-24 border-t border-gray-100">
    <h2 class="text-2xl md:text-3xl font-serif mb-8 text-center">Language & Translation</h2>
    <div class="space-y-6 text-lg leading-relaxed text-gray-700">
      <p>Alongside his photographic work, Bruce works professionally as a Czech–English literary translator and interpreter. He began working professionally as a literary translator and interpreter in 2024 and was awarded the Susanna Roth Award for English Translation in 2025.</p>
      <p>His translation work includes contemporary literature, cultural writing, and institutional materials. Services are available for publishers, artists, and cultural organizations, including exhibition texts, press materials, and public programs.</p>
      <p>Translation and interpretation inquiries are welcome.</p>
    </div>
  </section>
</Layout>
