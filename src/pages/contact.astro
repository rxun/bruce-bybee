---
import Layout from '../components/Layout.astro';
---

<Layout title="Contact - Bruce Bybee Photography">
  <section class="max-w-2xl mx-auto px-8 py-24">
    <h1 class="text-3xl md:text-4xl font-serif mb-4 text-center">Start a Conversation</h1>
    <p class="text-lg text-gray-700 text-center mb-2">
      Whether you're organizing a performance, mounting an exhibition, planning a public program, or seeking portrait photography, I'd be glad to hear more.
    </p>
    <p class="text-lg text-gray-700 text-center mb-12">
      Please include the date, location, and a brief description of your project. I respond within 24 hours.
    </p>

    <form id="contact-form" class="space-y-6">
      <!-- Name -->
      <div>
        <label for="name" class="block text-sm font-medium text-gray-900 mb-1">Name</label>
        <input type="text" id="name" name="name" required
          class="w-full px-4 py-3 border border-gray-200 rounded-sm text-sm focus:outline-none focus:border-gray-900 transition-colors" />
      </div>

      <!-- Email -->
      <div>
        <label for="email" class="block text-sm font-medium text-gray-900 mb-1">Email</label>
        <input type="email" id="email" name="email" required
          class="w-full px-4 py-3 border border-gray-200 rounded-sm text-sm focus:outline-none focus:border-gray-900 transition-colors" />
      </div>

      <!-- Organization (optional) -->
      <div>
        <label for="organization" class="block text-sm font-medium text-gray-900 mb-1">Organization <span class="text-gray-400 font-normal">(optional)</span></label>
        <input type="text" id="organization" name="organization"
          class="w-full px-4 py-3 border border-gray-200 rounded-sm text-sm focus:outline-none focus:border-gray-900 transition-colors" />
      </div>

      <!-- Type of Project -->
      <div>
        <label for="projectType" class="block text-sm font-medium text-gray-900 mb-1">Type of Project</label>
        <select id="projectType" name="projectType" required
          class="w-full px-4 py-3 border border-gray-200 rounded-sm text-sm focus:outline-none focus:border-gray-900 transition-colors bg-white">
          <option value="" disabled selected>Select a project type</option>
          <option value="Live Events & Performances">Live Events & Performances</option>
          <option value="Exhibitions & Installations">Exhibitions & Installations</option>
          <option value="Portraiture">Portraiture</option>
          <option value="Touring Artist Coverage">Touring Artist Coverage</option>
          <option value="Institutional Partnership">Institutional Partnership</option>
          <option value="Translation / Interpretation">Translation / Interpretation</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <!-- Event Date -->
      <div>
        <label for="eventDate" class="block text-sm font-medium text-gray-900 mb-1">Event Date</label>
        <input type="date" id="eventDate" name="eventDate"
          class="w-full px-4 py-3 border border-gray-200 rounded-sm text-sm focus:outline-none focus:border-gray-900 transition-colors" />
      </div>

      <!-- Message -->
      <div>
        <label for="message" class="block text-sm font-medium text-gray-900 mb-1">Message</label>
        <textarea id="message" name="message" rows="5" required
          class="w-full px-4 py-3 border border-gray-200 rounded-sm text-sm focus:outline-none focus:border-gray-900 transition-colors resize-vertical"></textarea>
      </div>

      <!-- Submit -->
      <button type="submit" id="submit-btn"
        class="w-full px-8 py-3 text-sm tracking-wide bg-gray-900 text-white hover:bg-gray-800 transition-colors">
        Send Inquiry
      </button>

      <!-- Status messages -->
      <p id="form-success" class="hidden text-center text-green-700 text-sm">Thank you! Your inquiry has been sent. You'll receive a confirmation email shortly.</p>
      <p id="form-error" class="hidden text-center text-red-700 text-sm">Something went wrong. Please try again or email brucectbybee@gmail.com directly.</p>
    </form>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMsg = document.getElementById('form-success')!;
  const errorMsg = document.getElementById('form-error')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    const data = {
      name: (document.getElementById('name') as HTMLInputElement).value,
      email: (document.getElementById('email') as HTMLInputElement).value,
      organization: (document.getElementById('organization') as HTMLInputElement).value,
      projectType: (document.getElementById('projectType') as HTMLSelectElement).value,
      eventDate: (document.getElementById('eventDate') as HTMLInputElement).value,
      message: (document.getElementById('message') as HTMLTextAreaElement).value,
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        successMsg.classList.remove('hidden');
        form.reset();
      } else {
        errorMsg.classList.remove('hidden');
      }
    } catch {
      errorMsg.classList.remove('hidden');
    }

    submitBtn.disabled = false;
    submitBtn.textContent = 'Send Inquiry';
  });
</script>
