---
import Layout from '../../components/Layout.astro';
import { v2 as cloudinary } from 'cloudinary';
import { existsSync, readFileSync } from 'fs';
import { join } from 'path';

cloudinary.config({
  cloud_name: import.meta.env.CLOUDINARY_CLOUD_NAME,
  api_key: import.meta.env.CLOUDINARY_API_KEY,
  api_secret: import.meta.env.CLOUDINARY_API_SECRET,
});

export function getStaticPaths() {
  const categories = [
    // { slug: 'Concerts', folder: 'bruce-bybee/Concerts', label: 'Concerts' },
    { slug: 'Performances', folder: 'bruce-bybee/Performance', label: 'Performances' },
    { slug: 'Exhibitions', folder: 'bruce-bybee/Exhibitions', label: 'Exhibitions' },
    // { slug: 'Talks and Public Programs', folder: 'bruce-bybee/Talks and Public Programs', label: 'Talks & Public Programs' },
    { slug: 'Portraits', folder: 'bruce-bybee/Portraits', label: 'Portraits' },
    { slug: 'Special Events', folder: 'bruce-bybee/Special Events', label: 'Special Events' },
  ];

  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { folder: cat.folder, label: cat.label },
  }));
}

const { category } = Astro.params;
const { folder, label } = Astro.props;

let photos: { publicId: string; src: string; srcSet: string; fullSrc: string; name: string; width: number; height: number }[] = [];
type IndexedPhoto = { publicId: string; src: string; srcSet: string; fullSrc: string; name: string; width: number; height: number; index: number };
type JustifiedRow = { photos: IndexedPhoto[]; height: number; isLastRow: boolean };
let rows: JustifiedRow[] = [];

try {
  const result = await cloudinary.search
    .expression(`folder:"${folder}"`)
    .sort_by('display_name', 'asc')
    .max_results(100)
    .execute();

  photos = result.resources.map((resource: any) => {
    const name = resource.public_id.split('/').pop().replace(/\.[^/.]+$/, '');
    return {
      publicId: resource.public_id,
      src: cloudinary.url(resource.public_id, {
        width: 800,
        crop: 'limit',
        quality: 90,
        format: 'webp',
      }),
      srcSet: [600, 800, 1200, 1600]
        .map(
          (w) =>
            `${cloudinary.url(resource.public_id, {
              width: w,
              crop: 'limit',
              quality: 90,
              format: 'webp',
            })} ${w}w`
        )
        .join(', '),
      fullSrc: cloudinary.url(resource.public_id, {
        width: 1800,
        quality: 92,
        format: 'webp',
      }),
      name,
      width: resource.width,
      height: resource.height,
    };
  });

  // Apply custom order if a per-category order file exists
  const orderFile = join(process.cwd(), 'src', 'data', `${category.toLowerCase()}-order.json`);
  if (existsSync(orderFile)) {
    const order: string[] = JSON.parse(readFileSync(orderFile, 'utf-8'));
    const photoMap = new Map(photos.map(p => [p.publicId, p]));
    const orderedIds = new Set(order);
    photos = [
      ...order.map(id => photoMap.get(id)).filter((p): p is typeof photos[0] => !!p),
      ...photos.filter(p => !orderedIds.has(p.publicId)),
    ];
  }

  // Justified layout: pack photos into rows so every photo in a row shares the same height
  const CONTAINER_WIDTH = 1200;
  const GAP = 8;
  const TARGET_HEIGHT = 304;
  const MIN_HEIGHT = 265;

  let currentRow: IndexedPhoto[] = [];
  let arSum = 0;

  photos.forEach((photo, i) => {
    const ar = photo.width / photo.height;
    const newArSum = arSum + ar;
    const newCount = currentRow.length + 1;
    const predictedH = (CONTAINER_WIDTH - (newCount - 1) * GAP) / newArSum;

    if (currentRow.length > 0 && predictedH < MIN_HEIGHT) {
      // Adding this photo would make the row too short — close the row without it
      rows.push({
        photos: currentRow,
        height: Math.round((CONTAINER_WIDTH - (currentRow.length - 1) * GAP) / arSum),
        isLastRow: false,
      });
      currentRow = [{ ...photo, index: i }];
      arSum = ar;
    } else {
      currentRow.push({ ...photo, index: i });
      arSum = newArSum;
    }
  });

  if (currentRow.length > 0) {
    rows.push({ photos: currentRow, height: TARGET_HEIGHT, isLastRow: true });
  }
} catch (e) {
  console.error('Error fetching photos:', e);
}
---

<Layout title={`${label} - Bruce Bybee Photography`}>
  <div id="page-loader" class="fixed inset-0 bg-stone-50 z-[100]" style="transition: opacity 0.6s ease;"></div>
  <section class="page-section-wide">
    <a href="/gallery" class="inline-flex items-center text-sm text-gray-500 hover:text-gray-900 transition-colors mb-8">
      &larr; Back to Gallery
    </a>
    <h1 class="page-title mb-12">{label}</h1>

    <!-- Photo Grid -->
    {rows.length > 0 ? (
      <div id="photo-grid" class="flex flex-col opacity-0" style="gap: 8px;">
        {rows.map((row) => (
          <div class="flex" style={`height: ${row.height}px; gap: 8px;`}>
            {row.photos.map((photo) => (
              <div
                class="photo-item-animate overflow-hidden cursor-pointer"
                style={row.isLastRow
                  ? `width: ${Math.round(photo.width / photo.height * row.height)}px; flex-shrink: 0; animation-delay: ${Math.min(photo.index, 15) * 0.06}s`
                  : `flex: ${photo.width / photo.height}; animation-delay: ${Math.min(photo.index, 15) * 0.06}s`}
              >
                <img
                  src={photo.index < 9 ? photo.src : ''}
                  srcset={photo.index < 9 ? photo.srcSet : ''}
                  data-src={photo.src}
                  data-srcset={photo.srcSet}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  alt={photo.name}
                  width={photo.width}
                  height={photo.height}
                  class={`w-full h-full object-cover transition-opacity duration-300 hover:opacity-90 ${photo.index >= 9 ? 'lazy-image' : ''}`}
                  data-photo-index={photo.index}
                  data-full-src={photo.fullSrc}
                  loading={photo.index < 9 ? 'eager' : 'lazy'}
                />
              </div>
            ))}
          </div>
        ))}
      </div>
    ) : (
      <p class="text-center text-gray-500 py-20">Photos coming soon.</p>
    )}
  </section>

  <!-- Photo Modal -->
  <div id="photo-modal" class="fixed inset-0 bg-black/70 z-50 hidden items-center justify-center transition-all duration-300 ease-out opacity-0">
    <div class="relative w-full h-full flex items-center justify-center">
      <button id="modal-close" class="absolute top-4 right-4 text-white text-3xl transition-colors duration-500 ease-in-out hover:text-gray-300 z-20">
        &times;
      </button>
      <button id="modal-prev" class="absolute left-0 top-16 bottom-16 w-16 flex items-center justify-center text-6xl z-10">
        <span class="transform scale-y-150 text-white transition-colors duration-500 ease-in-out hover:text-gray-300">&lsaquo;</span>
      </button>
      <button id="modal-next" class="absolute right-0 top-16 bottom-16 w-16 flex items-center justify-center text-6xl z-10">
        <span class="transform scale-y-150 text-white transition-colors duration-500 ease-in-out hover:text-gray-300">&rsaquo;</span>
      </button>
      <div id="loading-animation" class="absolute inset-0 flex items-center justify-center pointer-events-none transition-opacity duration-300" style="opacity: 0;">
        <div class="flex space-x-2">
          <div class="loading-dot"></div>
          <div class="loading-dot"></div>
          <div class="loading-dot"></div>
        </div>
      </div>
      <div class="flex items-center justify-center w-full h-full px-16">
        <img id="modal-image" src="" alt="" class="max-w-full max-h-[85vh] object-contain transition-all duration-300 ease-out transform">
      </div>
    </div>
  </div>

  <style>
    @media (max-width: 640px) {
      #photo-grid > div {
        flex-direction: column;
        height: auto !important;
      }
      #photo-grid > div > div {
        width: 100% !important;
        flex: none !important;
        height: auto !important;
      }
      #photo-grid > div > div img {
        height: auto;
      }
    }

    #photo-grid img {
      color: transparent;
      background-color: #f3f4f6;
    }
    .lazy-image {
      min-height: 200px;
      opacity: 0;
      transition: opacity 0.5s ease;
    }
    .lazy-image.loaded {
      opacity: 1;
      background-color: transparent;
    }
    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .photo-item-animate {
      opacity: 0;
      animation: slideUp 0.45s ease forwards;
      animation-play-state: paused;
    }
    #photo-grid.ready .photo-item-animate {
      animation-play-state: running;
    }
    #photo-modal.modal-open {
      opacity: 1;
    }
    #modal-image.image-loaded {
      opacity: 1;
      transform: scale(1);
    }
    #modal-image.image-loading {
      opacity: 0;
      transform: scale(0.95);
    }
    .loading-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background-color: white;
      animation: bounce 1.4s ease-in-out infinite both;
    }
    .loading-dot:nth-child(1) { animation-delay: -0.32s; }
    .loading-dot:nth-child(2) { animation-delay: -0.16s; }
    @keyframes bounce {
      0%, 80%, 100% { transform: scale(0.8); opacity: 0.5; }
      40% { transform: scale(1.2); opacity: 1; }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const grid = document.getElementById('photo-grid');

      // Wait for eager images (first 9) to load before revealing the grid
      const eagerImages = grid ? Array.from(grid.querySelectorAll('img:not(.lazy-image)')) as HTMLImageElement[] : [];
      let loadedCount = 0;

      function revealGrid() {
        if (grid) {
          grid.style.opacity = '1';
          grid.classList.add('ready');
        }
        const loader = document.getElementById('page-loader') as HTMLElement;
        if (loader) {
          loader.style.opacity = '0';
          setTimeout(() => loader.remove(), 600);
        }
      }

      function checkAllLoaded() {
        if (loadedCount >= eagerImages.length) revealGrid();
      }

      if (eagerImages.length === 0) {
        revealGrid();
      } else {
        eagerImages.forEach(img => {
          if (img.complete) {
            loadedCount++;
          } else {
            img.addEventListener('load', () => { loadedCount++; checkAllLoaded(); });
            img.addEventListener('error', () => { loadedCount++; checkAllLoaded(); });
          }
        });
        checkAllLoaded();
        setTimeout(revealGrid, 6000);
      }

      // Lazy loading
      const lazyImages = document.querySelectorAll('.lazy-image');
      if (lazyImages.length > 0) {
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const img = entry.target as HTMLImageElement;
              const src = img.getAttribute('data-src');
              const srcset = img.getAttribute('data-srcset');
              if (src) {
                img.src = src;
                if (srcset) img.srcset = srcset;
                img.addEventListener('load', () => {
                  img.classList.remove('lazy-image');
                  img.classList.add('loaded');
                });
                obs.unobserve(img);
              }
            }
          });
        }, { rootMargin: '100px' });
        lazyImages.forEach(img => observer.observe(img));
      }

      // Modal
      const modal = document.getElementById('photo-modal')!;
      const modalImage = document.getElementById('modal-image') as HTMLImageElement;
      const modalClose = document.getElementById('modal-close')!;
      const modalPrev = document.getElementById('modal-prev')!;
      const modalNext = document.getElementById('modal-next')!;
      const loadingAnimation = document.getElementById('loading-animation')!;
      const allImages = Array.from(document.querySelectorAll('[data-photo-index]'));
      let currentIndex = 0;

      const photosArray = allImages.map((img) => ({
        src: img.getAttribute('data-full-src') || (img as HTMLImageElement).src,
        alt: (img as HTMLImageElement).alt,
      }));

      const preloaded = new Map<string, Promise<HTMLImageElement>>();
      function preload(src: string) {
        if (preloaded.has(src)) return preloaded.get(src)!;
        const img = new Image();
        const p = new Promise<HTMLImageElement>((res, rej) => { img.onload = () => res(img); img.onerror = rej; });
        img.src = src;
        preloaded.set(src, p);
        return p;
      }

      function preloadAdjacent(i: number) {
        if (i > 0) preload(photosArray[i - 1].src);
        if (i < photosArray.length - 1) preload(photosArray[i + 1].src);
      }

      function showImage(i: number) {
        currentIndex = i;
        const src = photosArray[i].src;
        modalImage.src = '';
        modalImage.className = 'max-w-full max-h-[85vh] object-contain transition-all duration-300 ease-out transform image-loading';
        loadingAnimation.style.opacity = '1';

        const reveal = () => {
          modalImage.src = src;
          modalImage.alt = photosArray[i].alt;
          loadingAnimation.style.opacity = '0';
          modalImage.className = 'max-w-full max-h-[85vh] object-contain transition-all duration-300 ease-out transform image-loaded';
        };

        if (preloaded.has(src)) {
          preloaded.get(src)!.then(reveal).catch(reveal);
        } else {
          setTimeout(reveal, 150);
        }
        preloadAdjacent(i);
      }

      function openModal(i: number) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        setTimeout(() => modal.classList.add('modal-open'), 10);
        showImage(i);
      }

      function closeModal() {
        const current = allImages[currentIndex] as HTMLElement;
        if (current) current.scrollIntoView({ behavior: 'smooth', block: 'center' });
        modal.classList.remove('modal-open');
        setTimeout(() => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          modalImage.src = '';
          modalImage.className = 'max-w-full max-h-[85vh] object-contain transition-all duration-300 ease-out transform image-loading';
          loadingAnimation.style.opacity = '0';
        }, 300);
        document.body.style.overflow = 'auto';
      }

      function navigate(dir: number) {
        modalImage.className = 'max-w-full max-h-[85vh] object-contain transition-all duration-200 ease-out transform image-loading';
        setTimeout(() => {
          currentIndex = (currentIndex + dir + photosArray.length) % photosArray.length;
          showImage(currentIndex);
        }, 200);
      }

      allImages.forEach((img, i) => img.addEventListener('click', () => openModal(i)));
      modalClose.addEventListener('click', closeModal);
      modalPrev.addEventListener('click', () => navigate(-1));
      modalNext.addEventListener('click', () => navigate(1));
      modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', (e) => {
        if (modal.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeModal();
        if (e.key === 'ArrowLeft') navigate(-1);
        if (e.key === 'ArrowRight') navigate(1);
      });
    });
  </script>
</Layout>
